__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/

# Local scratch and reproducibility copies.
results/*_dryrun/
results/*_repro/
results/*_ci_run/
outputs/*_repro*/
outputs/*_repeat*/

# Experiment outputs are artifacts, not source. Provenance for each run
# lives in its own provenance.json (source hashes + git commit), so the
# working tree stays clean and git_commit fully determines code state.
# (Already-tracked legacy files remain tracked.)
results/
outputs/

# Editor and operating-system clutter.
.DS_Store
Thumbs.db

# Workspace organization: preserve local workspaces without adding them to Git.
.worktrees/
.superpowers/
.wheels/

# Regenerable intermediate presentation serialization.
artifacts/**/build/deck_proto.json
artifacts/**/build/draft_proto.json
